# LLM provider: together (default) | openrouter | google
LLM_PROVIDER=together

# API key for the selected provider (only the active one is required)
# OPENROUTER_API_KEY=sk-or-your-key-here
TOGETHER_API_KEY=your-together-key-here
# GOOGLE_API_KEY=your-google-key-here

# Optional: override the provider's default models
# CHAT_MODEL=
# CONDENSER_MODEL=

HF_TOKEN=hf_your-token

# --- Prose lane (optional) ---------------------------------------------------
# Routes /chat and /study prose generation to a separate provider.
# /reflect always stays on LLM_PROVIDER.
# Unset (the default) = prose uses LLM_PROVIDER, i.e. no behavior change.
# PROSE_PROVIDER=ollama
# PROSE_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# HF_ENDPOINT_URL=https://<your-endpoint>.endpoints.huggingface.cloud/v1

# --- Embedding evaluation (scripts/compare_retrieval.py) ---------------------
# GOOGLE_API_KEY (set above) also feeds this script's Gemini embedding calls.
# Same key, two axes: LLM_PROVIDER=google routes /chat text generation; this
# script uses the same key for embeddings. Setting it does not, by itself,
# change LLM_PROVIDER.

# --- Embedding lane -----------------------------------------------------------
# Unset = BAAI/bge-m3 in-process (2.3 GB of RAM, no network, today's behavior).
# Set to deepinfra or novita to call the SAME model over HTTP and let the
# service scale to zero. Switch only after:
#   uv run python -m scripts.verify_embedding_parity --provider deepinfra
# EMBEDDING_PROVIDER=deepinfra
# DEEPINFRA_API_KEY=
# NOVITA_API_KEY=
