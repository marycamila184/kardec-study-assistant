# LLM provider: groq (default) | openrouter | together
LLM_PROVIDER=groq

# API key for the selected provider (only the active one is required)
GROQ_API_KEY=gsk_your-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here
# TOGETHER_API_KEY=your-together-key-here

# Optional: override the provider's default models
# CHAT_MODEL=
# CONDENSER_MODEL=

HF_TOKEN=hf_your-token

# --- Prose lane (optional) ---------------------------------------------------
# Routes /chat and /study prose generation to a separate provider.
# /reflect always stays on LLM_PROVIDER.
# Unset (the default) = prose uses LLM_PROVIDER, i.e. no behavior change.
# PROSE_PROVIDER=ollama
# PROSE_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# HF_ENDPOINT_URL=https://<your-endpoint>.endpoints.huggingface.cloud/v1
