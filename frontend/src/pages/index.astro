---
import Base from '../layouts/Base.astro';
import App from '../App.jsx';
---
<Base
  title="Dialogando com a Doutrina — perguntas e respostas na obra de Kardec"
  description="Um assistente de estudo que busca respostas diretamente nas obras da Codificação Espírita, sempre indicando a questão e a obra de origem. Gratuito e sem fins comerciais."
  canonical="https://dialogandodoutrina.com.br/"
  ogTitle="Dialogando com a Doutrina"
  ogDescription="Tire dúvidas sobre a Doutrina Espírita com respostas baseadas nas obras de Allan Kardec, com a fonte sempre citada."
>
  {/* client:only porque App.jsx lê localStorage no inicializador do useTheme
      e não sobrevive a uma renderização em tempo de build. Consequência que
      governa todo o resto: o Astro não emite nada do app no HTML, então todo
      texto que o buscador lê tem de ser escrito aqui, ao lado da island. */}
  <App client:only="react" />
</Base>
