---
import '../styles/globals.css';

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogType = 'website',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{title}</title>
  <meta name="description" content={description}>

  {/* Antes chegavam via @import no topo de globals.css — descobertos tarde e
      serializados atrás do parsing do CSS. Como <link>, o navegador os
      descobre no primeiro passe do <head>, na página cujo propósito inteiro é
      ser lida rápido. */}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap">

  {/* O app responde nos dois domínios e serve o mesmo conteúdo. Sem canonical,
      o buscador indexa as duas cópias e divide o sinal entre elas. */}
  <link rel="canonical" href={canonical}>

  {/* Pinta a barra do navegador no Android, que é onde um link encaminhado
      por WhatsApp costuma aterrissar. É o BRAND_BLUE de constants/theme.js.
      O mesmo hex aparece no theme_color do manifest; scripts/check_pwa_manifest.mjs
      falha se os três (aqui, o manifest e o theme.js) divergirem. */}
  <meta name="theme-color" content="#6B9BB8">

  {/* O que torna o site instalável: com o manifest a pessoa pode guardar isto
      na tela de início e abrir numa janela própria, sem barra de endereço.
      Não há service worker de propósito — os assets com hash já vêm
      `immutable` da Vercel, então não haveria o que acelerar, e a falha
      característica de um SW é servir versão velha em silêncio. A decisão e a
      medição estão em docs/superpowers/specs/2026-08-27-pwa-instalavel-design.md

      Está no layout compartilhado, então /sobre/ e /trilhas/ também o recebem.
      Isso não fere a regra de "nenhum script na Sobre": <link> não é script. */}
  <link rel="manifest" href="/manifest.webmanifest">

  {/* O iOS ignora os ícones do manifest e lê este link. O PNG tem de ser
      opaco — transparência é composta sobre preto. */}
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  {/* Antes daqui o projeto não tinha favicon nenhum: nenhum arquivo e nenhum
      link, e toda aba mostrava o ícone de página em branco do navegador. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  {/* og:image e og:url precisam ser absolutas: caminho relativo é descartado
      em silêncio por todo crawler. scripts/check_discovery_assets.mjs guarda
      isso, porque a falha não aparece na tela — só no card em branco. */}
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="Dialogando com a Doutrina">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content="https://dialogandodoutrina.com.br/preview.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="pt_BR">
  <meta name="twitter:card" content="summary_large_image">
</head>
<body>
  <slot />
</body>
</html>
